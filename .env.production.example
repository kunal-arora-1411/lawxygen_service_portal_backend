# Production configuration for api.lawxygen.in.
#
# Copy to `.env.production` on the server and fill in. That file is gitignored and must
# stay that way — it holds the keys to the money and to the encrypted PAN and bank rows.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Every value the application actually needs is validated at boot by src/lib/env.ts, so
# a malformed one fails the process start rather than the first request that needs it.

# ---- Environment ------------------------------------------------------------
# ecosystem.config.cjs also sets NODE_ENV, APP_ENV, PORT and HOST=127.0.0.1, and its
# values win over this file. Editing them here changes nothing under PM2.
NODE_ENV=production
APP_ENV=production
PORT=4000
LOG_LEVEL=info

# ---- Origins ----------------------------------------------------------------
# PORTAL_ORIGIN drives CORS and must be the exact origin, with no trailing slash — a
# wildcard is invalid once credentials are included, and the session is a cookie.
PORTAL_ORIGIN=https://app.lawxygen.in
API_ORIGIN=https://api.lawxygen.in

# The leading dot is what makes the session cookie visible to app.lawxygen.in as well as
# api.lawxygen.in. Unset it and a client signs in and immediately appears signed out.
COOKIE_DOMAIN=.lawxygen.in

# ---- Database ---------------------------------------------------------------
# Neon, production branch. `sslmode=require` is not optional over the public internet.
# Prefer the pooled connection string for an app that opens many short-lived queries.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/lawxygen?sslmode=require

# ---- Secrets ----------------------------------------------------------------
# Generate both on the server, never reuse the local values, never commit either:
#
#   openssl rand -base64 48    # SESSION_SECRET
#   openssl rand -base64 32    # FIELD_ENCRYPTION_KEY
#
# SESSION_SECRET also keys the OTP HMAC (src/lib/crypto.ts). Rotating it signs everyone
# out and invalidates outstanding OTPs, which is survivable.
SESSION_SECRET=

# FIELD_ENCRYPTION_KEY encrypts PAN and bank details at rest. **Changing it makes every
# existing encrypted row permanently unreadable** — there is no rotation path built yet
# (backlog item 20). Set it once, back it up somewhere that is not this server, and do
# not touch it again.
FIELD_ENCRYPTION_KEY=

# ---- Payments ---------------------------------------------------------------
# Test-mode keys are fine to launch with and take no real money. Swap to live keys only
# once the Razorpay production account is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this to the secret configured on the Razorpay webhook itself. Unlike local — where
# the gateway cannot reach the host and /payments/:ref/confirm carries the load — here
# the webhook is reachable and is the source of truth for payment success. A wrong value
# means every real payment notification is rejected.
#
# Webhook URL to register at Razorpay: https://api.lawxygen.in/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Payouts ----------------------------------------------------------------
# RazorpayX. Leave blank until the business account exists: blank makes a release refuse
# outright, which is correct. A fake value would make the adapter believe it is
# configured and attempt a real transfer.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT=

# ---- Email ------------------------------------------------------------------
# Blank in production means the API refuses to send rather than dropping receipts
# silently. Until these are set, no client gets a payment receipt and no professional
# gets an assignment notice — this is the launch blocker in backlog item 2.
# MAIL_FROM must be a sender verified with the provider.
MAIL_PROVIDER_KEY=
MAIL_FROM=Lawxygen <no-reply@lawxygen.in>

# ---- Google sign-in ---------------------------------------------------------
# Add https://api.lawxygen.in/auth/google/callback to the authorised redirect URIs in
# the Google Cloud console, or the callback is rejected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMS (mobile OTP) -------------------------------------------------------
# Needs DLT registration in India before any of it works.
SMS_PROVIDER_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=

# ---- WhatsApp ---------------------------------------------------------------
# All four or none. A non-empty pair makes the adapter call Meta for real, so a
# placeholder here is worse than blank.
#
# Webhook URL to register with Meta: https://api.lawxygen.in/webhooks/whatsapp
# The verify token is WHATSAPP_APP_SECRET.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# ---- Observability ----------------------------------------------------------
# Validated today and used nowhere (backlog item 19). Harmless to set now.
SENTRY_DSN=
