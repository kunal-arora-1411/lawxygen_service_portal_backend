# Copy to .env.local and fill in. Never commit a filled-in copy.
# Every variable is validated by src/lib/env.ts at process start — a missing or
# malformed value fails the boot, not the first request that needs it.

# ---- Runtime ----
NODE_ENV=development
APP_ENV=local
PORT=4000

# Where the portal is served from. Used for CORS.
PORTAL_ORIGIN=http://localhost:3000

# Public origin of this API. Must match the redirect URI registered with Google:
#   <API_ORIGIN>/auth/google/callback
API_ORIGIN=http://localhost:4000

# Cookie scope. Leave EMPTY locally (host-only on localhost).
# In staging/production set to .lawxygen.in so app. and api. share the session.
COOKIE_DOMAIN=

# ---- M0 — database ----
# Neon. A URL whose host contains "-pooler." is detected automatically and prepared
# statements are disabled for it, because the pooled endpoint is PgBouncer in
# transaction mode and prepared statements break there intermittently under load.
DATABASE_URL=

# ---- M0 — auth ----
# 32+ bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- M0 — transactional SMS (mobile OTP) ----
# Indian transactional SMS requires DLT-registered templates.
SMS_PROVIDER_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=

# ---- M2 — payments ----
# Transactional email. Without these, local logs the message and anything else
# refuses to send rather than silently dropping receipts.
MAIL_PROVIDER_KEY=
MAIL_FROM=

# 32 raw bytes base64. Encrypts PAN and bank details. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info
